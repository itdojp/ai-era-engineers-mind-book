{
  "name": "ai時代のプロフェッショナルitエンジニアの思考法",
  "version": "1.0.0",
  "description": "AI ネイティブな実務を前提に、意思決定・説明責任・運用統制を成果物として残すための実践書",
  "main": "index.md",
  "scripts": {
    "start": "cd docs && bundle exec jekyll serve --livereload",
    "build": "cd docs && bundle exec jekyll build",
    "test": "npm run lint && npm run test:reader-maintainer-boundary && npm run check:reader-maintainer-boundary && npm run test:shared-metadata && npm run check:shared-metadata && npm run test:case-study-quantitative-coverage && npm run check:case-study-quantitative-coverage && npm run check-ux-contract && npm run check-links",
    "lint": "markdownlint 'docs/**/*.md' --ignore docs/_site",
    "test:reader-maintainer-boundary": "node scripts/check-reader-maintainer-boundary.js --self-test",
    "check:reader-maintainer-boundary": "node scripts/check-reader-maintainer-boundary.js",
    "check:reader-maintainer-boundary:built": "node scripts/check-reader-maintainer-boundary.js --built-site docs/_site",
    "test:case-study-quantitative-coverage": "node scripts/check-case-study-quantitative-coverage.js --self-test",
    "check:case-study-quantitative-coverage": "node scripts/check-case-study-quantitative-coverage.js",
    "check:case-study-quantitative-coverage:built": "node scripts/check-case-study-quantitative-coverage.js --built-site docs/_site",
    "check-ux-contract": "node scripts/check-ux-contract.js",
    "check-ux-contract:built": "node scripts/check-ux-contract.js --built-site docs/_site",
    "check-links": "find . -name '*.md' -not -path './node_modules/*' -not -path './docs/_site/*' -print0 | xargs -0 markdown-link-check --config .markdown-link-check.json",
    "deploy": "gh-pages -d docs/_site",
    "test:shared-metadata": "node scripts/check-shared-metadata-contract.js --self-test",
    "check:shared-metadata": "node scripts/check-shared-metadata-contract.js"
  },
  "keywords": [
    "book",
    "documentation",
    "ja"
  ],
  "author": "ITDO Inc.",
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://itdojp.github.io/ai-era-engineers-mind-book/",
  "bugs": {
    "url": "https://github.com/itdojp/ai-era-engineers-mind-book/issues"
  },
  "devDependencies": {
    "entities": "4.5.0",
    "gh-pages": "^6.0.0",
    "markdown-link-check": "^3.11.2",
    "markdownlint-cli": "^0.49.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itdojp/ai-era-engineers-mind-book.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "undici": "7.28.0",
    "cheerio": {
      "encoding-sniffer": "1.0.2"
    }
  }
}
